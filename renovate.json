{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":dependencyDashboard"
  ],
  "kubernetes": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "helm-values": {
    "fileMatch": [
      "(^|/)[^/]*values\\.ya?ml$"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "helm upgrade --install --repo --version pins in .mise.toml (cluster bootstrap commands)",
      "fileMatch": [
        "^\\.mise\\.toml$"
      ],
      "matchStrings": [
        "helm upgrade --install \\S+ (?<depName>\\S+) --repo (?<registryUrl>\\S+) --version (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Explicit # renovate: version annotations in Dockerfiles, .mise.toml, and Talos patches",
      "fileMatch": [
        "(^|/)Dockerfile$",
        "^\\.mise\\.toml$",
        "^src/talos/patches/image\\.yaml$"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\n\\s*(?:ARG\\s+)?[A-Z0-9_]+\\s*=\\s*\"?(?<currentValue>[^\"\\s]+)\"?",
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)(?:\\s+extractVersion=(?<extractVersion>\\S+))?\\n\\s*image:\\s*\\S+:(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Argo CD Application helm chart targetRevision (both repoURL/chart field orders; git sources without an adjacent chart: never match). The argocd manager only parses spec.source, so multi-source apps are invisible to it.",
      "fileMatch": [
        "^src/apps/.*application.*\\.yaml$"
      ],
      "matchStrings": [
        "repoURL: (?<registryUrl>\\S+)\\s+chart: (?<depName>\\S+)\\s+targetRevision: (?<currentValue>\\S+)",
        "chart: (?<depName>\\S+)\\s+repoURL: (?<registryUrl>\\S+)\\s+targetRevision: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "description": "Image pins in helm valuesObject where repository + tag are pinned together (invisible to the docker/kubernetes managers). v-prefixed semver only.",
      "fileMatch": [
        "^src/apps/.*application.*\\.yaml$"
      ],
      "matchStrings": [
        "repository: (?<depName>\\S+)\\s+tag: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "open-webui image tag (repository comes from chart defaults; only the tag is pinned in valuesObject)",
      "fileMatch": [
        "^src/apps/services/ai/open-webui/application\\.yaml$"
      ],
      "matchStrings": [
        "tag: (?<currentValue>v\\S+)"
      ],
      "depNameTemplate": "ghcr.io/open-webui/open-webui",
      "packageNameTemplate": "ghcr.io/open-webui/open-webui",
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Helm chart bumps: PR for manual review only (values keys / templates / migrations can break an app)",
      "matchDatasources": [
        "helm"
      ],
      "automerge": false
    },
    {
      "description": "Deps extracted from Argo Application manifests (chart versions + valuesObject image pins): PR for manual review only",
      "matchPaths": [
        "^src/apps/.*application.*\\.yaml$"
      ],
      "automerge": false
    },
    {
      "description": "Keep digest updates enabled for images that only publish floating :latest tags",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/paperclipai/paperclip",
        "dperson/samba",
        "quay.io/samba.org/samba-metrics"
      ],
      "pinDigests": true
    },
    {
      "description": "Cluster OS, Kubernetes, and Gateway API release bumps: manual review only",
      "matchPackageNames": [
        "siderolabs/talos",
        "kubernetes/kubernetes",
        "kubernetes-sigs/gateway-api"
      ],
      "automerge": false
    },
    {
      "description": "Longhorn forbids skipping minor versions on upgrade; open one PR per minor release",
      "matchDatasources": [
        "helm"
      ],
      "matchPackageNames": [
        "longhorn"
      ],
      "separateMultipleMinor": true,
      "automerge": false
    },
    {
      "description": "Stateful database major version bumps require explicit migration planning",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "postgres",
        "mariadb",
        "valkey/valkey",
        "redis"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
